#!/usr/bin/env php
<?php

require dirname(__DIR__).'/vendor/autoload.php';

use Symfony\Component\Process\Process;

if (false === getenv('DISPLAY') || '' === getenv('DISPLAY')) {
    fwrite(STDERR, "A visible DISPLAY is required. No headless fallback.\n");
    exit(1);
}
putenv('PLAYWRIGHT_HEADLESS=false');
$_SERVER['PLAYWRIGHT_HEADLESS'] = 'false';
$process = new Process([PHP_BINARY, 'vendor/bin/phpunit', '--log-junit', 'var/qa/test/junit.xml'], dirname(__DIR__), ['PLAYWRIGHT_HEADLESS' => 'false'], timeout: 300);
pcntl_async_signals(true);
foreach ([SIGTERM, SIGINT, SIGHUP] as $signal) {
    pcntl_signal($signal, static function (int $received) use ($process): void {
        $process->stop(5, SIGTERM);
        exit(128 + $received);
    });
}
register_shutdown_function(static function () use ($process): void {
    if ($process->isRunning()) {
        $process->stop(5, SIGTERM);
    }
});
exit($process->run(static function (string $type, string $data): void {
    fwrite('err' === $type ? STDERR : STDOUT, $data);
}));
