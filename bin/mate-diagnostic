#!/usr/bin/env php
<?php

require dirname(__DIR__).'/vendor/autoload.php';

use Symfony\Component\Process\Process;

chdir(dirname(__DIR__));
$mode = $argv[1] ?? '';
$argument = $argv[2] ?? '';
$command = match ($mode) {
    'services' => ['symfony-services', '--query='.$argument, '--limit=10'],
    'logs' => ['monolog-context-search', '--key=correlation_id', '--value='.$argument, '--limit=20'],
    'profiles' => ['symfony-profiler-list', '--limit=5'],
    default => [],
};
$artifact = match ($mode) {
    'services' => 'var/cache/dev/*Container.xml',
    'logs' => 'var/log/*.log',
    'profiles' => 'var/cache/dev/profiler/*/*/*',
    default => '',
};
if ([] === $command || [] === glob($artifact) || (in_array($mode, ['services', 'logs'], true) && '' === $argument)) {
    fwrite(STDERR, "Missing diagnostic artifacts or required narrow filter. Warm the dev cache or record a local request first.\n");
    exit(1);
}
$process = new Process([PHP_BINARY, 'vendor/bin/mate', 'tools:call', ...$command, '--format=json'], timeout: 60);
exit($process->run(static function (string $type, string $data): void {
    fwrite('err' === $type ? STDERR : STDOUT, $data);
}));
