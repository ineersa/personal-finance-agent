#!/usr/bin/env php
<?php

require dirname(__DIR__).'/vendor/autoload.php';

use Symfony\Component\Process\Process;

$exit = 0;
foreach (array_slice($_SERVER['argv'] ?? [], 1) as $task) {
    $process = new Process([PHP_BINARY, 'vendor/bin/castor', $task], dirname(__DIR__), timeout: 1200);
    $code = $process->run(static function (string $type, string $data): void {
        fwrite('err' === $type ? STDERR : STDOUT, $data);
    });
    if (0 === $exit && 0 !== $code) {
        $exit = $code;
    }
}
exit($exit);
