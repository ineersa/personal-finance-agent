#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
mkdir -p var/tooling/home
if [ -n "${DISPLAY:-}" ] && command -v xauth >/dev/null 2>&1; then
    umask 077
    touch var/tooling/Xauthority
    xauth -i nlist "$DISPLAY" | sed 's/^..../ffff/' | xauth -f var/tooling/Xauthority nmerge -
fi
exec docker run --rm --init --user "$(id -u):$(id -g)" \
    --volume "$PWD:/app" \
    --volume /tmp/.X11-unix:/tmp/.X11-unix:ro \
    --env XDG_CONFIG_HOME=/app/var/tooling/home/.config \
    --env XDG_CACHE_HOME=/app/var/tooling/home/.cache \
    --env DISPLAY --env XAUTHORITY=/app/var/tooling/Xauthority \
    personal-finance-agent-task02-tooling "$@"
