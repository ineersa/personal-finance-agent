{
    "name": "ineersa/personal-finance-agent",
    "description": "Personal finance demo for the Symfony AI hackathon",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pcntl": "*",
        "ext-pdo_sqlite": "*",
        "ext-posix": "*",
        "ext-sqlite3": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "easycorp/easyadmin-bundle": "^5.8",
        "symfony/ai-agent": "~1.0.0@beta",
        "symfony/ai-platform": "~1.0.0@beta",
        "symfony/asset": "8.2.*@dev",
        "symfony/asset-mapper": "8.2.*@dev",
        "symfony/console": "8.2.*@dev",
        "symfony/dotenv": "8.2.*@dev",
        "symfony/flex": "^2.10",
        "symfony/framework-bundle": "8.2.*@dev",
        "symfony/lock": "8.2.*@dev",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "8.2.*@dev",
        "symfony/runtime": "8.2.*@dev",
        "symfony/security-bundle": "8.2.*",
        "symfony/twig-bundle": "8.2.*@dev",
        "symfony/yaml": "8.2.*@dev",
        "twig/twig": "^3.24"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.2.*"
        },
        "ai-mate": {
            "extension": false,
            "scan-dirs": [
                "mate/src"
            ],
            "includes": [
                "mate/config.php"
            ]
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jolicode/castor": "^1.9",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4",
        "playwright-php/playwright": "^1.5",
        "playwright-php/playwright-symfony": "^0.11.0",
        "symfony/ai-mate": "^0.15.0",
        "symfony/ai-monolog-mate-extension": "^0.15.0",
        "symfony/ai-symfony-mate-extension": "^0.15.0",
        "symfony/maker-bundle": "^1.68",
        "symfony/web-profiler-bundle": "8.2.*@dev"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "Mate\\": "mate/src/"
        }
    }
}
