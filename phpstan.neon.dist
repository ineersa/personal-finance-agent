includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/jolicode/castor/extension.neon
parameters:
    level: 6
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - .castor
        - castor.php
        - .php-cs-fixer.dist.php
        - tests
        - bin/console
        - public/index.php
        - bin/browser-suite
        - bin/qa-aggregate
        - bin/mate-diagnostic
        - mate/config.php
    tmpDir: var/phpstan
