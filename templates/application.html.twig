{% extends 'base.html.twig' %}

{% block body_class %}finance-page{% endblock %}

{% block body %}
    <div class="finance-app">
        <a class="skip-link" href="#main-content">Skip to content</a>
        <aside class="app-sidebar" aria-label="Workspace">
            <a class="app-brand" href="{{ path('app_home') }}" aria-label="Personal finance home">
                <span class="brand-mark" aria-hidden="true">pf</span>
                <span>Personal finance<span class="brand-caption">A little more clarity.</span></span>
            </a>

            <nav class="app-nav" aria-label="Main navigation">
                <a class="nav-item is-current" href="{{ path('app_home') }}" aria-current="page"><span>Chat</span><span aria-hidden="true">↗</span></a>
                <span class="nav-label">Your finances</span>
                {% if app.user %}
                    <a class="nav-item" href="{{ path('admin') }}">Manage finances</a>
                    <a class="nav-item" href="{{ path('app_planned', {page: 'upload'}) }}">Upload (not implemented)</a>
                    <a class="nav-item" href="{{ path('app_planned', {page: 'review'}) }}">Review (not implemented)</a>
                    <a class="nav-item" href="{{ path('app_settings') }}">Settings</a>
                {% else %}
                    <a class="nav-item" href="{{ path('app_login') }}">Log in</a>
                {% endif %}
            </nav>

            <div class="sidebar-note">
                <span class="eyebrow">Work in progress</span>
                <p>Manage sources and approved transactions. Chat, uploads, and draft review are not implemented yet.</p>
                {% if app.user %}
                    <form action="{{ path('app_logout') }}" method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit">Log out</button>
                    </form>
                {% endif %}
            </div>
        </aside>

        <div class="app-workspace">
            <header class="workspace-header">
                <span>Finance chat</span>
                <span class="preview-badge">Chat preview</span>
            </header>
            <main id="main-content" class="workspace-main" tabindex="-1">
                {% block workspace %}{% endblock %}
            </main>
            <footer class="workspace-footer">Personal finance assistant <span aria-hidden="true">·</span> Built with Symfony</footer>
        </div>
    </div>
{% endblock %}
