{% extends '@!EasyAdmin/layout.html.twig' %}

{% block header_logo %}{{ include('chrome/brand.html.twig') }}{% endblock %}
{% block responsive_header_logo %}{{ include('chrome/brand.html.twig') }}{% endblock %}
{% block sidebar_footer %}{{ include('chrome/note.html.twig') }}{% endblock %}
{% block content_footer %}{{ include('chrome/footer.html.twig') }}{% endblock %}
{% block content_top_header %}
    <span class="workspace-context">{{ is_granted('ROLE_ADMIN') ? 'Administration' : 'Your finances' }}</span>
    {{ parent() }}
{% endblock %}

{% block user_menu %}
    {{ parent() }}
    <twig:ea:ActionMenu:ActionList:Divider />
    <twig:ea:ActionMenu:ActionList:Content>
        <form action="{{ path('app_logout') }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="dropdown-item">
                <twig:ea:Icon name="internal:sign-out" />
                <span>Log out</span>
            </button>
        </form>
    </twig:ea:ActionMenu:ActionList:Content>
{% endblock %}
