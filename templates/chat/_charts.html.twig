<div class="chat-chart-links" id="chat-charts-{{ conversation.id }}-{{ user.id }}">
    {% for chart in conversation.charts %}
        {% if chart.message == user.id.toRfc4122 %}
            <button type="button" class="chat-chart-link" data-chat-charts-target="link" data-action="chat-charts#open" data-chart-url="{{ path(constant('App\\Chat\\ChartFiles::ROUTE'), {conversation: conversation.id, file: chart.file}) }}" data-chart-title="{{ chart.title|default('Chart ' ~ loop.index) }}" aria-controls="chat-chart-panel" aria-expanded="false">{{ chart.title|default('Chart ' ~ loop.index) }} <span aria-hidden="true">↗</span></button>
        {% endif %}
    {% endfor %}
</div>
