<div id="{{ chat.composer_id }}" data-controller="chat-model">
    <p id="{{ chat.composer_id }}-error" role="status" data-chat-view-target="error"></p>
    {{ form_label(form.question) }}
    {{ form_widget(form.question) }}
    <div class="composer-toolbar">
        <span class="preview-note">Enter to send · Shift+Enter for a new line</span>
        <div class="chat-composer-actions">
            <details class="chat-model-menu" data-chat-model-target="menu" data-action="keydown.esc->chat-model#close click@window->chat-model#dismiss">
                <summary aria-controls="{{ chat.composer_id }}-model-panel">Model</summary>
                <div id="{{ chat.composer_id }}-model-panel" class="chat-model-panel">
                    {{ form_label(form.model) }}
                    <div class="chat-model-dropdown">{{ form_widget(form.model) }}</div>
                    <div class="chat-reasoning-control">
                        <div data-chat-model-target="fallback">
                            {{ form_label(form.effort) }}
                            {{ form_widget(form.effort) }}
                        </div>
                        <div data-chat-model-target="enhanced" hidden>
                            <div class="chat-reasoning-caption">
                                <label for="{{ form.effort.vars.id }}-range">{{ form.effort.vars.label }}</label>
                                <output for="{{ form.effort.vars.id }}-range" data-chat-model-target="current"></output>
                            </div>
                            <input id="{{ form.effort.vars.id }}-range" class="chat-reasoning-slider" type="range" min="0" max="0" step="1" value="0" aria-describedby="{{ form.effort.vars.id }}-steps" data-chat-model-target="slider" data-action="input->chat-model#slide">
                            <div id="{{ form.effort.vars.id }}-steps" class="chat-reasoning-steps" data-chat-model-target="steps"></div>
                        </div>
                    </div>
                </div>
            </details>
            {% include 'chat/_send.html.twig' %}
        </div>
    </div>
</div>
