<button id="{{ constant('App\\Chat\\Workspace::DELETE_DOM_ID') }}-{{ retained.id }}" type="submit" class="dropdown-item text-danger"{% if retained.active %} disabled title="Wait for this chat to finish before deleting it"{% endif %} data-action-confirmation="true" data-action-confirmation-title="Delete chat?" data-action-confirmation-content="Delete this conversation and its private charts? This cannot be undone. Financial records are not affected." data-action-confirmation-button="Delete chat" data-bs-toggle="modal" data-bs-target="#modal-action-confirmation"><twig:ea:Icon name="internal:delete" />Delete chat</button>
