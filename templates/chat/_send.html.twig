{% set states = enum('Symfony\\AI\\Agent\\Execution\\ExecutionStatus') %}
{% set busy = chat.control and chat.control.status in [states.Pending.value, states.Running.value] %}
<button id="{{ chat.send_id }}" class="send-button" type="{{ busy ? 'button' : 'submit' }}" data-chat-send data-chat-control-target="button" data-action="click->chat-control#stop" data-chat-control-state="{{ chat.control|json_encode|e('html_attr') }}" {% if busy and chat.control.stopping %}disabled{% endif %}>{{ busy ? (chat.control.stopping ? 'Stopping…' : 'Stop') : 'Send message' }} <span aria-hidden="true">{{ busy ? '■' : '↑' }}</span></button>
