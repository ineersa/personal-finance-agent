{% set processing = enum('App\\Enum\\ProcessingStatus') %}
<section id="{{ constant('App\\Chat\\Workspace::DOM_ID') }}" class="chat-workspace" aria-label="Conversation" data-chat-state="{{ chat.status }}">
    {% if chat.turns is empty %}
        <div class="chat-welcome">
            <p class="eyebrow">Your conversation</p>
            <h2>What’s on your mind?</h2>
            <p>Start with a question. Follow up as you go.</p>
        </div>
    {% endif %}
    <div class="chat-turns">
        {% for turn in chat.turns %}
            <article class="chat-turn" id="chat-turn-{{ loop.index }}">
                <div class="chat-question"><span class="visually-hidden">You</span><p>{{ turn.question }}</p></div>
                <div class="chat-reply">
                    <span class="chat-speaker">ChatGPT</span>
                    {% if turn.reasoning %}
                        <details class="chat-reasoning" id="chat-reasoning-{{ loop.index }}"><summary>Reasoning summary</summary><div class="chat-markdown">{{ turn.reasoning|markdown_to_html|sanitize_html('app.chat') }}</div></details>
                    {% endif %}
                    {% if turn.commentary %}<div class="chat-commentary chat-markdown">{{ turn.commentary|markdown_to_html|sanitize_html('app.chat') }}</div>{% endif %}
                    {% if turn.answer %}<div class="chat-answer chat-markdown">{{ turn.answer|markdown_to_html|sanitize_html('app.chat') }}</div>{% endif %}
                    {% if loop.last %}
                        <p class="chat-progress" role="status" data-chat-status="{{ chat.status }}">{{ chat.status == processing.Running.value ? 'Responding…' : (chat.status == processing.Queued.value ? 'Waiting for ChatGPT…' : (chat.status == processing.Completed.value ? 'Reply complete' : chat.status|capitalize)) }}</p>
                        {% if chat.error %}<p class="chat-error" role="alert">{{ chat.error }}</p>{% endif %}
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
</section>
