<section id="{{ chat.dom_id }}" class="chat-workspace" aria-label="Conversation" data-chat-execution>
    {% set exchanges = chat_exchanges(chat.messages) %}
    {% if exchanges is empty %}
        <div class="chat-welcome" id="chat-welcome-{{ chat.conversation_id }}">
            <p class="eyebrow">Your conversation</p>
            <h2>What’s on your mind?</h2>
            <p>Start with a question. Follow up as you go.</p>
        </div>
    {% endif %}
    <div class="chat-turns" id="chat-turns-{{ chat.conversation_id }}">
        {% for exchange in exchanges %}
            {% include 'chat/_turn.html.twig' with {conversation: chat.conversation, user: exchange|first} %}
        {% endfor %}
    </div>
    <div id="chat-error-{{ chat.conversation_id }}"></div>
</section>
