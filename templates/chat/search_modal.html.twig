<twig:ea:Modal id="{{ constant('App\\Chat\\ChatSearch::MODAL_ID') }}" title="Search chats" size="xl" data-controller="chat-search" aria-label="Search chats">
    <twig:block name="body">
        <form action="{{ path(constant('App\\Chat\\ChatSearch::ROUTE')) }}" method="get" class="chat-search" role="search" data-turbo="true" data-turbo-frame="{{ constant('App\\Chat\\ChatSearch::FRAME_ID') }}">
            <label for="chat-search-query" class="visually-hidden">Search chats</label>
            <input id="chat-search-query" data-chat-search-target="input" type="search" name="{{ constant('App\\Chat\\ChatSearch::QUERY_PARAMETER') }}" maxlength="{{ constant('App\\Chat\\ChatSearch::QUERY_LENGTH') }}" placeholder="Search chats…" enterkeyhint="search">
        </form>
        {{ include('chat/search_results.html.twig', {query: '', results: []}) }}
    </twig:block>
    <twig:block name="footer"><twig:ea:Modal:Close>Close</twig:ea:Modal:Close></twig:block>
</twig:ea:Modal>
