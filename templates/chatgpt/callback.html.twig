<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <title>ChatGPT connection · Finance</title>
    <style>
        :root { color-scheme: dark; font-family: system-ui, sans-serif; background: #101416; color: #f1f5f3; }
        body { min-height: 100vh; display: grid; place-items: center; margin: 0; }
        main { max-width: 32rem; margin: 1.5rem; padding: 3rem; border: 1px solid #33413c; border-radius: 1.5rem; background: #19211e; box-shadow: 0 1.5rem 5rem #0004; }
        .mark { color: #93d7b7; font-weight: 700; letter-spacing: .15em; }
        h1 { font-size: 2rem; letter-spacing: -.04em; }
        p { line-height: 1.7; color: #b8c6bf; }
        a { display: inline-block; margin-top: 1rem; padding: .85rem 1.3rem; border-radius: 999px; background: #b9edd1; color: #14261d; font-weight: 650; text-decoration: none; }
        a:focus-visible { outline: 3px solid white; outline-offset: 4px; }
    </style>
</head>
<body>
<main>
    <div class="mark">FINANCE</div>
    {% if status == 'connected' %}
        <h1>ChatGPT is connected.</h1>
        <p>Your connection has been verified. You can return to Finance now. Chat generation is not available yet.</p>
    {% elseif status == 'permission' %}
        <h1>One more step.</h1>
        <p>Sign-in completed, but ChatGPT plan usage is not enabled. Return to Finance to reconnect and grant permission.</p>
    {% else %}
        <h1>Connection not completed.</h1>
        <p>The request may have expired, or authorization could not be verified. Return to Finance to try again.</p>
    {% endif %}
    <a href="{{ finance_url }}" rel="noreferrer">Return to Finance</a>
    <p>You can close this tab after returning.</p>
</main>
</body>
</html>
