{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Chat{% endblock %}
{% block content_header_wrapper %}{% endblock %}
{% block main %}
    {% set statuses = enum('App\\ChatGpt\\ConnectionStatus') %}
    <div class="finance-chat" data-controller="chat-view import-catch-up" data-import-catch-up-url-value="{{ path(constant('App\\Chat\\Workspace::SNAPSHOT_ROUTE'), {conversation: chat.conversation_id}) }}" data-import-catch-up-target-selector-value="[data-chat-execution], [data-chat-send]">
        <header class="chat-header">
            <div class="chat-heading">
                <h1>Chat</h1>
                <form action="{{ path(constant('App\\Chat\\Workspace::NEW_ROUTE')) }}" method="post" data-turbo="true">
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Chat\\Workspace::NEW_CSRF')) }}" data-controller="csrf-protection">
                    <input type="hidden" name="conversation" value="{{ chat.conversation_id }}">
                    <button class="chat-new" type="submit">New chat</button>
                </form>
                {% if chat.conversation_id %}
                    {% if chat.saved %}
                        <span class="chat-saved" role="status">Saved chat</span>
                    {% else %}
                        <form action="{{ path(constant('App\\Chat\\Workspace::SAVE_ROUTE')) }}" method="post" data-turbo="true">
                            <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Chat\\Workspace::SAVE_CSRF')) }}" data-controller="csrf-protection">
                            <input type="hidden" name="conversation" value="{{ chat.conversation_id }}">
                            <button class="chat-new" type="submit">Save chat</button>
                        </form>
                    {% endif %}
                {% endif %}
            </div>
            {% if chatgpt_status == statuses.Connected %}
                <p class="chatgpt-status">ChatGPT connected <span aria-hidden="true">·</span> <a href="{{ path(constant('App\\ChatGpt\\Connection::SETTINGS_ROUTE'), {_fragment: constant('App\\ChatGpt\\Connection::SETTINGS_FRAGMENT')}) }}">Manage</a></p>
            {% endif %}
        </header>
        {% if chat_history is not empty %}
            <form class="chat-history" action="{{ path(constant('App\\Chat\\Workspace::CHAT_ROUTE')) }}" method="get">
                <label for="chat-history">Chat history</label>
                <select id="chat-history" name="conversation">
                    {% for retained in chat_history %}
                        <option value="{{ retained.id }}"{% if retained.id == chat.conversation_id %} selected{% endif %}>{{ retained.saved ? 'Saved · ' : 'Temporary · ' }}{{ retained.createdAt|date('Y-m-d H:i') }} · {{ retained.label|slice(0, 60) }}</option>
                    {% endfor %}
                </select>
                <button class="chat-new" type="submit">Open chat</button>
                <span class="preview-note">Five temporary chats, plus saved chats.</span>
            </form>
        {% endif %}
        {% if chatgpt_status != statuses.Connected %}
            <section class="chat-empty" aria-labelledby="welcome-heading">
                <span class="intro-mark" aria-hidden="true">pf</span>
                <h2 id="welcome-heading">Make sense of your money.</h2>
                <p class="intro-copy">A space to think things through, one question at a time.</p>
                <section class="chatgpt-connection" aria-label="ChatGPT connection">
                    <p>Connect ChatGPT to start a conversation. Your Finance login stays separate.</p>
                    {% include 'chatgpt/_connect.html.twig' %}
                    {% if chatgpt_status in [statuses.Permission, statuses.Reconnect] %}
                        <p><a href="{{ path(constant('App\\ChatGpt\\Connection::SETTINGS_ROUTE'), {_fragment: constant('App\\ChatGpt\\Connection::SETTINGS_FRAGMENT')}) }}">Manage connection in Settings</a></p>
                    {% endif %}
                    <p class="preview-note">Authorization opens OpenAI. Credentials stay in private files on this server, not in your browser.</p>
                    {% if question|default('') %}
                        <label for="unsent-question">Your unsent message</label>
                        <textarea id="unsent-question" readonly>{{ question }}</textarea>
                    {% endif %}
                </section>
            </section>
        {% endif %}
        <div class="chat-scroll" data-chat-view-target="scroll" data-action="scroll->chat-view#trackScroll toggle->chat-view#rememberSummary:capture" tabindex="0" aria-label="Conversation history">
            {% include 'chat/_workspace.html.twig' %}
        </div>
        {% if chatgpt_status == statuses.Connected %}
            <div class="chat-compose-area">
                <button class="chat-jump" type="button" data-chat-view-target="jump" data-action="chat-view#jumpToLatest" hidden>Jump to latest ↓</button>
                <form action="{{ path(constant('App\\Chat\\Workspace::SUBMIT_ROUTE')) }}" method="post" class="chat-composer" data-turbo="true">
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Chat\\Workspace::SUBMIT_CSRF')) }}" data-controller="csrf-protection">
                    <input type="hidden" name="conversation" value="{{ chat.conversation_id }}">
                    {% include 'chat/_composer.html.twig' %}
                </form>
                <p class="chat-disclosure">Messages and queried financial records are sent to ChatGPT. Charts are generated locally by Unovis and saved privately with this conversation. Interactive charts run in a restricted sandbox without external network access.</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
