{% extends '@EasyAdmin/page/login.html.twig' %}

{% block login_form_wrapper %}
    {# Omit EasyAdmin's default hidden target so Symfony can honor a saved protected URL. #}
    <form method="post" action="{{ path('app_login') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        {{ block('login_form_credentials_wrapper') }}
        <button type="submit" class="btn btn-primary btn-lg w-100">{{ _sign_in_label }}</button>
    </form>
{% endblock %}
