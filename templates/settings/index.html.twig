{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form with ['@EasyAdmin/crud/form_theme.html.twig'] only %}

{% block content_title %}Settings{% endblock %}
{% block main %}
    <p>These preferences do not convert or change stored transaction amounts. Reporting conversion is not implemented yet.</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.reportingCurrency) }}
        {{ form_row(form.moneyLocale) }}
        <button class="btn btn-primary" type="submit">Save preferences</button>
    {{ form_end(form) }}
    <section id="chatgpt-connection" class="import-summary chatgpt-settings" aria-labelledby="chatgpt-heading">
        <h2 id="chatgpt-heading">ChatGPT connection</h2>
        {% if chatgpt_status == 'connected' %}
            <p class="chatgpt-account">{{ chatgpt_identity ?? 'Connected account · display details unavailable' }}</p>
            <p role="status">ChatGPT connected. Chat generation is not available yet.</p>
        {% elseif chatgpt_status == 'permission' %}
            <p role="status">Sign-in saved, but plan usage is not enabled. Reconnect to grant permission.</p>
        {% elseif chatgpt_status == 'reconnect' %}
            <p role="status">Your connection could not be verified. Please reconnect.</p>
        {% elseif chatgpt_status == 'unavailable' %}
            <p role="status">Local ChatGPT connection is not configured for this instance.</p>
        {% else %}
            <p role="status">No ChatGPT account connected.</p>
        {% endif %}
        <p>One ChatGPT account can be active at a time. Disconnect before connecting a different account. Your Finance login is unchanged.</p>
        <div class="chatgpt-settings-actions">
            {% if chatgpt_status in ['connected', 'permission', 'reconnect'] %}
                <a class="btn btn-secondary" href="https://chatgpt.com/settings/usage" rel="noreferrer">Manage usage</a>
                <form method="post" action="{{ path('app_chatgpt_connection', {action: 'disconnect'}) }}" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token('chatgpt-disconnect') }}">
                    <button class="btn btn-outline-danger" type="submit">Disconnect ChatGPT</button>
                </form>
            {% endif %}
            {% if chatgpt_status != 'connected' %}
                <form method="post" action="{{ path('app_chatgpt_connection', {action: 'connect'}) }}" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token('chatgpt-connect') }}">
                    <button class="chatgpt-button" type="submit"{% if chatgpt_status == 'unavailable' %} disabled{% endif %}>Continue with ChatGPT</button>
                </form>
            {% endif %}
        </div>
    </section>
    {% if canResetDemo %}
        <section class="import-summary demo-reset-settings">
            <h2>Restore the local demo</h2>
            <p>Start again with the canonical accounts and history. This resets the entire demo database, not just your account, and removes uploaded statement files.</p>
            <a class="btn btn-danger" href="{{ path('admin_demo_reset') }}">Reset demo data…</a>
        </section>
    {% endif %}
{% endblock %}
