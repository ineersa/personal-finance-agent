{% extends 'application.html.twig' %}
{% block title %}Settings · Personal finance{% endblock %}
{% block workspace_title %}Settings{% endblock %}
{% block workspace_status %}{% endblock %}
{% block workspace %}
    <section class="form-card">
    <h1>Settings</h1>
    {% for message in app.flashes('success') %}<p role="status">{{ message }}</p>{% endfor %}
    <p>This preference does not convert or change original transaction amounts. Reporting conversion is not implemented yet.</p>
    {{ form_start(form, {attr: {class: 'finance-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.reportingCurrency) }}
        <button class="primary-button" type="submit">Save preferences</button>
    {{ form_end(form) }}
    </section>
{% endblock %}
