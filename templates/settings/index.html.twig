{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form with ['@EasyAdmin/crud/form_theme.html.twig'] only %}

{% block content_title %}Settings{% endblock %}
{% block main %}
    <p>These preferences do not convert or change stored transaction amounts. Reporting conversion is not implemented yet.</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.reportingCurrency) }}
        {{ form_row(form.moneyLocale) }}
        <button class="btn btn-primary" type="submit">Save preferences</button>
    {{ form_end(form) }}
    {% if canResetDemo %}
        <section class="import-summary demo-reset-settings">
            <h2>Restore the local demo</h2>
            <p>Start again with the canonical accounts and history. This resets the entire demo database, not just your account, and removes uploaded statement files.</p>
            <a class="btn btn-danger" href="{{ path('admin_demo_reset') }}">Reset demo data…</a>
        </section>
    {% endif %}
{% endblock %}
