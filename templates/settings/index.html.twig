{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form with ['@EasyAdmin/crud/form_theme.html.twig'] only %}

{% block content_title %}Settings{% endblock %}
{% block main %}
    {% set statuses = enum('App\\ChatGpt\\ConnectionStatus') %}
    <p>These preferences do not convert or change stored transaction amounts. Reporting conversion is not implemented yet.</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.reportingCurrency) }}
        {{ form_row(form.moneyLocale) }}
        <button class="btn btn-primary" type="submit">Save preferences</button>
    {{ form_end(form) }}
    <section id="{{ constant('App\\ChatGpt\\Connection::SETTINGS_FRAGMENT') }}" class="import-summary chatgpt-settings" aria-labelledby="chatgpt-heading">
        <h2 id="chatgpt-heading">ChatGPT connection</h2>
        {% if chatgpt_status == statuses.Connected %}
            <p class="chatgpt-account">{{ chatgpt_identity ?? 'Connected account · display details unavailable' }}</p>
            <p role="status">ChatGPT connected.</p>
        {% elseif chatgpt_status == statuses.Disconnected %}
            <p role="status">No ChatGPT account connected.</p>
        {% endif %}
        {% if chatgpt_status == statuses.Connected %}
            <p class="chatgpt-settings-help">Disconnecting keeps this account’s registration so you can reconnect later.</p>
        {% else %}
            <div class="chatgpt-settings-connect">
                {% include 'chatgpt/_connect.html.twig' %}
            </div>
        {% endif %}
        {% if chatgpt_status in [statuses.Connected, statuses.Permission, statuses.Reconnect] %}
            <div class="chatgpt-settings-actions">
                <a class="btn btn-secondary" href="{{ constant('Symfony\\AI\\Platform\\Bridge\\OpenAIChatGPT\\Auth\\OAuthConfig::USAGE_URL') }}" rel="noreferrer">Manage usage</a>
                <form method="post" action="{{ path(constant('App\\ChatGpt\\Connection::DISCONNECT_ROUTE')) }}" data-turbo="false">
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\ChatGpt\\Connection::DISCONNECT_CSRF')) }}">
                    <button class="btn btn-outline-danger" type="submit">Disconnect ChatGPT</button>
                </form>
            </div>
        {% endif %}
    </section>
    {% if canResetDemo %}
        <section class="import-summary demo-reset-settings">
            <h2>Restore the local demo</h2>
            <p>Start again with the canonical accounts and history. This resets the entire demo database, not just your account, and removes uploaded statement files.</p>
            <a class="btn btn-danger" href="{{ path('admin_demo_reset') }}">Reset demo data…</a>
        </section>
    {% endif %}
{% endblock %}
