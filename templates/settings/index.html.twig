{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form with ['@EasyAdmin/crud/form_theme.html.twig'] only %}

{% block content_title %}Settings{% endblock %}
{% block main %}
    <p>This preference does not convert or change original transaction amounts. Reporting conversion is not implemented yet.</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.reportingCurrency) }}
        <button class="btn btn-primary" type="submit">Save preferences</button>
    {{ form_end(form) }}
{% endblock %}
