{% set status = statement.processingStatus.value %}
{% set meanings = {expense: 'Expense', income: 'Income', refund: 'Refund', own_account_transfer: 'Own-account transfer', credit_card_payment: 'Credit-card payment', unknown: 'Needs review'} %}
{% set recurrences = {recurring_bill: 'Recurring bill', subscription: 'Subscription', other_recurring: 'Other recurring', non_recurring: 'Not recurring', unknown: 'Not determined'} %}
<section id="statement-processing-{{ statement.id }}" class="import-results" data-import-state="{{ status }}">
    <header class="import-summary">
        <p class="import-eyebrow">{{ statement.source.name }}</p>
        <h2 data-processing-status data-status="{{ status }}">{{ {completed: 'Import complete', queued: 'Import queued', running: 'Import in progress', failed: 'Import failed'}[status] }}</h2>
        <p class="import-filename">{{ statement.originalFilename }}</p>
        {% if status == 'completed' %}
            {% if drafts is not empty %}
                <p class="import-outcome"><strong>{{ drafts|length }} unapproved draft {{ drafts|length == 1 ? 'transaction' : 'transactions' }}</strong></p>
                <p>Your file has been processed. These drafts are saved, but are not included in your financial totals.</p>
                <a class="btn btn-primary" href="#draft-results">View {{ drafts|length }} draft {{ drafts|length == 1 ? 'transaction' : 'transactions' }}</a>
            {% else %}
                <p class="import-outcome">Processing completed. No drafts remain for review.</p>
            {% endif %}
        {% elseif status in ['queued', 'running'] %}
            <p role="status">{{ status == 'queued' ? 'Your file is waiting to be processed.' : 'Your file is being read and categorized.' }} This page updates automatically. You can leave and return from Statements.</p>
        {% else %}
            <p>Your file could not be processed. No completed results are available for this attempt.</p>
        {% endif %}
        {% if statement.processingError %}<p class="import-error" role="alert">{{ statement.processingError }}</p>{% endif %}
        {% if status in ['failed', 'running'] %}
            <button class="btn btn-primary" type="submit" form="statement-workflow-{{ statement.id }}" name="form[retry]" value="1">Retry processing</button>
        {% endif %}
    </header>
    <nav class="import-actions" aria-label="Statement actions">
        <a class="btn btn-secondary" href="{{ path('app_statement_download', {id: statement.id}) }}" data-turbo="false">Download original CSV</a>
        <a class="btn btn-secondary" href="{{ path('admin_statement_upload') }}">Upload another statement</a>
    </nav>
    {% if status == 'completed' and drafts is not empty %}
        <section class="import-drafts" aria-labelledby="draft-results">
            <h3 id="draft-results">Draft transactions requiring review: {{ drafts|length }}</h3>
            <p>Edit or delete individual rows, then approve all remaining transactions from this statement. Saving corrections does not approve a transaction.</p>
            <button class="btn btn-primary" type="submit" form="statement-workflow-{{ statement.id }}" name="form[approve]" value="1">Approve draft</button>
            <div class="table-responsive import-table" role="region" aria-label="Draft transactions" tabindex="0"><table class="table" data-draft-results>
                <thead><tr><th scope="col">Date</th><th scope="col">Description</th><th scope="col">Amount</th><th scope="col">Currency</th><th scope="col">Direction</th><th scope="col">Category</th><th scope="col">Transaction type</th><th scope="col">Recurrence</th><th scope="col">Actions</th></tr></thead>
                <tbody>{% for row in drafts %}<tr><td>{{ row.transactionDate ? row.transactionDate|date('Y-m-d') : 'Missing date' }}</td><td>{{ row.description }}</td><td>{{ row.amount matches '/^[+-]?[0-9]+(?:\.[0-9]+)?$/' and row.currency matches '/^[A-Z]{3}$/' ? row.amount|format_currency(row.currency, locale: statement.user.moneyLocale) : row.amount }}</td><td>{{ row.currency }}</td><td>{{ row.direction ? row.direction.value : 'Missing direction' }}</td><td>{{ row.category ? row.category.name : 'Uncategorized' }}</td><td data-meaning="{{ row.meaning.value }}">{{ meanings[row.meaning.value] }}</td><td data-recurrence="{{ row.recurrence.value }}">{{ recurrences[row.recurrence.value] }}</td><td><a href="{{ path('admin_transaction_edit', {entityId: row.id}) }}">Edit</a> <button type="button" class="btn btn-link" data-action="draft-delete#confirm" data-draft-delete-url-param="{{ path('admin_transaction_delete', {entityId: row.id}) }}">Delete</button></td></tr>{% endfor %}</tbody>
            </table></div>
        </section>
    {% endif %}
</section>
